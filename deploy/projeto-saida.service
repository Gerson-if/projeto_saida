# deploy/projeto-saida.service
#
# Serviço systemd do app web (Gunicorn). Instalação:
#   sudo cp deploy/projeto-saida.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now projeto-saida
#
# Ajuste User/Group/WorkingDirectory/EnvironmentFile para o seu ambiente.
# Veja deploy/DEPLOY.md para o passo a passo completo.

[Unit]
Description=Sistema de Controle de Saidas (Gunicorn)
After=network.target mariadb.service mysql.service
Wants=mariadb.service

[Service]
Type=simple
User=projeto_saida
Group=projeto_saida
WorkingDirectory=/opt/projeto_saida
EnvironmentFile=/opt/projeto_saida/.env
ExecStart=/opt/projeto_saida/venv/bin/gunicorn -c deploy/gunicorn_conf.py "run:app"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening básico — o serviço não precisa de mais privilégios que estes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/projeto_saida/instance /opt/projeto_saida/app/static/uploads /opt/projeto_saida/app/static/relatorios

[Install]
WantedBy=multi-user.target
