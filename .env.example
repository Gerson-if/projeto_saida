# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copie para .env e ajuste os valores
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente: development | production | testing
FLASK_ENV=development

# Chave secreta das sessões — OBRIGATÓRIA em produção.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Em desenvolvimento, se você não definir isso, o sistema gera e guarda
# automaticamente uma chave só sua em instance/secret_key (não versionada).
# NUNCA use o valor de exemplo abaixo em produção — ele está no código-fonte
# público, e quem o conhece pode forjar sessões de qualquer usuário.
SECRET_KEY=troque-esta-chave-em-producao

# Banco de dados
# Dev (SQLite, padrão — não precisa definir):
# DATABASE_URL=sqlite:///instance/sistema_saida.db
#
# Produção (MariaDB/MySQL):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost/nome_banco

# Identidade visual (opcional — pode ser configurado pelo admin no painel)
# SISTEMA_NOME=Sistema de Controle de Saídas
# SISTEMA_SUBTITULO=Gestão de Saídas de Guarnição
# SISTEMA_ORGANIZACAO=Organização Militar

# Intervalo do scheduler de atualização de status (minutos)
# SCHEDULER_STATUS_INTERVAL_MINUTES=10

# ── Sessão ───────────────────────────────────────────────────────────────
# Duração da sessão comum (minutos) e do "lembrar-me" (dias)
# SESSION_LIFETIME_MINUTES=480
# REMEMBER_COOKIE_DAYS=14

# ── Proteção contra força bruta no login ───────────────────────────────────
# LOGIN_MAX_TENTATIVAS=5
# LOGIN_BLOQUEIO_MINUTOS=15

# ── Concorrência (SQLite) ───────────────────────────────────────────────────
# DB_COMMIT_MAX_TENTATIVAS=3
# SQLITE_BUSY_TIMEOUT_MS=8000

# ── Produção: proxy reverso (Nginx/Cloudflare/etc.) ─────────────────────────
# Deixe "true" (padrão) quando o Flask roda atrás de um proxy reverso que
# termina o TLS — necessário para IP/esquema (https) corretos em
# url_for(_external=True) e nos logs. Veja deploy/DEPLOY.md.
# BEHIND_PROXY=true

# ── Produção: agendador de atualização de status ────────────────────────────
# Com 1 worker Gunicorn, pode deixar "true" (padrão). Com vários workers,
# defina "false" aqui e use o timer systemd em deploy/ (evita o job rodar
# duplicado, uma vez por worker). Veja deploy/DEPLOY.md, seção 9.
# SCHEDULER_ENABLED=true

# ── Produção: quantidade de workers/threads do Gunicorn ─────────────────────
# Usadas por deploy/gunicorn_conf.py — não têm efeito fora dele.
# WEB_CONCURRENCY=1
# GUNICORN_THREADS=4

